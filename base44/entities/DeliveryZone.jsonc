{
  "name": "DeliveryZone",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "postalCodes": {
      "type": "array"
    },
    "deliveryFee": {
      "type": "number",
      "default": 0
    },
    "minOrder": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
